# ============================================================
# Variables de entorno — Kinova Backend
# ============================================================
# IMPORTANTE: Este archivo NO debe subirse al repo (.gitignore)
# ============================================================

# ---------- Base de datos (Supabase PostgreSQL) ----------
# Ir a: Supabase → Settings → Database → Connection string → URI
# Reemplazar [PASSWORD] con la contraseña de tu proyecto Supabase
# Reemplazar [PROJECT-REF] con el ID de tu proyecto (ej: abcdefghijklm)
# Reemplazar [REGION] con tu región (ej: us-east-1, sa-east-1)
#
# Opción A — Pooler (recomendada para backends con muchas conexiones):
# DATABASE_URL=postgresql+asyncpg://postgres.wgsdvdewnfaqytmpgalb:kinova20261@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
#
# Opción B — Conexión directa:
# Conexión DIRECTA (sin pgbouncer) — permite pool de conexiones persistentes (~50ms)
# El pooler (puerto 6543) requería NullPool que creaba una conexión nueva por request (~3s)
DATABASE_URL=postgresql+asyncpg://postgres:kinova20261@db.wgsdvdewnfaqytmpgalb.supabase.co:5432/postgres

# ---------- Autenticación JWT ----------
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-en-produccion-usar-algo-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
FRONTEND_URL=http://localhost:8081

# ---------- Motor de Pose ----------
POSE_CONFIDENCE_THRESHOLD=0.35
POSE_MODEL_COMPLEXITY=2

# ---------- Entorno ----------
ENVIRONMENT=development
DEBUG=true
