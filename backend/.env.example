# ============================================================
# Plantilla de variables de entorno — Kinova Backend
# ============================================================
# Copiar este archivo a `.env` y completar los valores reales.
# El archivo `.env` NO debe subirse al repo (está en .gitignore).
# ============================================================

# ---------- Base de datos ----------
# Para desarrollo local con SQLite:
DATABASE_URL=sqlite+aiosqlite:///./kinova.db
# Para producción con PostgreSQL (cambiar driver):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kinova

# ---------- Autenticación JWT ----------
# Generar una clave aleatoria en producción (ej: openssl rand -hex 32)
SECRET_KEY=cambiar-esta-clave-en-produccion-usar-algo-aleatorio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS ----------
# URL del frontend (Vite usa 5173 por defecto)
FRONTEND_URL=http://localhost:5173

# ---------- Motor de Pose ----------
POSE_CONFIDENCE_THRESHOLD=0.5
POSE_MODEL_COMPLEXITY=1

# ---------- Entorno ----------
# Valores: development, staging, production
ENVIRONMENT=development
DEBUG=true
